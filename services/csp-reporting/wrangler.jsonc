{
  "name": "cm-csp-reports-stage-only",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "REPORTS", "class_name": "ReportStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReportStore"]}],
  "ratelimits": [
    {"name": "CLIENT_RATE", "namespace_id": "915011501", "simple": {"limit": 30, "period": 60}},
    {"name": "GLOBAL_RATE", "namespace_id": "915011502", "simple": {"limit": 120, "period": 60}}
  ]
}
